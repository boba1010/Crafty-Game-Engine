    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	
	<PackageId>Crafty.InstancesManager</PackageId>
	<Version>0.1.0-ea</Version>
	  
	<Authors>Crafty</Authors>
	<Description>Instance management infrastructure for Crafty launchers.</Description>

