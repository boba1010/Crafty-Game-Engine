<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>

	<PackageId>Crafty.ChunkGeneration</PackageId>
	<Version>0.1.0-ea</Version>

	<Authors>Crafty</Authors>
	<Description>Chunk and world generation infrastructure for Crafty.</Description>

	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageTags>crafty;chunk-generation;world-generation;game-development</PackageTags>

	<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Entities\" />
  </ItemGroup>

<ItemGroup>
	<InternalsVisibleTo Include="Crafty.Testing" />
</ItemGroup>

<ItemGroup>
  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
</ItemGroup>

<ItemGroup>
  <ProjectReference Include="..\Crafty.SDK\Crafty.SDK.csproj" />
</ItemGroup>

</Project>
