<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<!-- <SelfContained>true</SelfContained> -->
	<PublishAot>true</PublishAot>
	<IsAotCompatible>true</IsAotCompatible>
	<EnableTrimAnalyzers>true</EnableTrimAnalyzers>
  </PropertyGroup>

    <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\Crafty.ChunkGeneration\Crafty.ChunkGeneration.csproj" />
    <ProjectReference Include="..\Crafty.SDK\Crafty.SDK.csproj" />
    <ProjectReference Include="..\CraftyNative\CraftyNative.csproj" />
    </ItemGroup>

    <Target Name="CopyAssets" AfterTargets="Build">
	    <ItemGroup>
		    <AssetFiles Include="Assets\**\*" />
	    </ItemGroup>

	    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(OutputPath)Assets\%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>
	
  <ItemGroup>
    <Folder Include="Entities\" />
  </ItemGroup>

</Project>
